# Workspace-level reference only. Each process loads its own service .env:
#   client/.env, server/.env, and ai-service/.env.
# Copy the relevant values below to the matching service file.

# Frontend (client/.env)
VITE_API_BASE_URL=http://localhost:5000/api

# Express backend (server/.env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/reallens_ai
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=
AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-this-development-placeholder

# FastAPI AI service (ai-service/.env)
HOST=127.0.0.1
PORT=8000
