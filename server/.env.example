# RealLens AI - Node.js Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Replace with production credentials in production)
MONGO_URI=mongodb://localhost:27017/reallens_ai

# Security & Authentication
# IMPORTANT: Use a cryptographically random string (min 32 characters) in production
JWT_SECRET=reallens_ai_jwt_secret_key_change_in_production
ALLOW_ADMIN_REGISTRATION=false

# Rate Limiting
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=50

# Upload Security Limits (100MB in bytes)
MAX_FILE_SIZE_BYTES=104857600

# Microservice Integrations & CORS
CLIENT_URL=http://localhost:5173
# Comma-separated additional exact frontend origins (for example, a LAN URL).
CORS_ORIGINS=
AI_SERVICE_URL=http://localhost:8000
